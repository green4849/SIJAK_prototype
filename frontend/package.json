{
  "name": "wipi-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && node scripts/check-boundaries.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build:demo": "tsc -b && vite build --mode demo",
    "dev:demo": "vite --mode demo",
    "e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "gen:api": "openapi-typescript src/shared/api/openapi.json -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/jua": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
