{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    // 시연 사본(src/demo)을 직접 불러 백엔드 값과 비교하는 시험용 (H37, demo-constants.spec.ts)
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["playwright.config.ts", "e2e"]
}
