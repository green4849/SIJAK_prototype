# 운영 웹 서버 (B10) — HTTPS 자동 발급(Let's Encrypt), 프론트 정적 파일, /api → 백엔드
# DOMAIN 환경변수에 실제 도메인 (예: sijak.example.kr). 로컬 확인용 기본값은 localhost(자체 서명).
{$DOMAIN:localhost} {
	encode zstd gzip

	# 음성 메시지 업로드 (백엔드 제한 2MB) 보다 조금 넉넉히
	request_body {
		max_size 5MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# 위치(같은 동네)·마이크(음성 메시지)만 이 사이트에서 허용
		Permissions-Policy "geolocation=(self), microphone=(self), camera=()"
		# 이 사이트 것만 실행·불러오기. 바깥은 동네 이름 찾기(OpenStreetMap)와 활동 사진(Unsplash)뿐.
		# 인라인 스크립트·스타일 없음 (React 의 style 은 CSSOM 으로 들어가 CSP 대상이 아님). 음성 메시지·3D는 blob: 을 쓴다.
		# 고치면 frontend/e2e/csp.spec.ts 가 이 줄을 읽어 여러 화면에서 위반이 없는지 본다 (H42)
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://images.unsplash.com; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://nominatim.openstreetmap.org; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# 기본: 매번 새로 확인 (index.html·sw.js·manifest — 배포 즉시 반영)
		header Cache-Control "no-cache"
		# 해시 이름 파일은 1년 캐시
		@immutable path /assets/* /icons/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# 화면 주소(SPA)는 모두 index.html 로
		try_files {path} /index.html
		file_server
	}
}
