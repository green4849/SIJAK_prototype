# 운영 환경값 — 복사해서 infra/.env.prod 로 (커밋 금지, .gitignore 에 포함)
#   cp infra/.env.prod.example infra/.env.prod && sh infra/gen-secrets.sh >> infra/.env.prod
# 아래 비밀값이 기본값이거나 비어 있으면 API가 뜨지 않는다 (B1).

# 서비스 도메인 — DNS A 레코드가 이 서버를 가리켜야 HTTPS 인증서가 발급된다
DOMAIN=sijak.example.kr

# 비밀값 (gen-secrets.sh 가 만들어 줌) — 잃어버리면 안 됨: 특히 DATA_ENCRYPTION_KEY 를 잃으면 전화번호 복호화 불가 (B12)
# POSTGRES_PASSWORD=
# JWT_SECRET=
# DATA_ENCRYPTION_KEY=
# PHONE_HASH_PEPPER=

# 본인인증 — 실제 PASS 계약(B4) 전 시범 운영이면 true (누구나 화면의 번호로 가입 가능해짐)
IDENTITY_PROVIDER=mock
ALLOW_MOCK_IDENTITY_IN_PROD=false

MIN_SIGNUP_AGE=60
