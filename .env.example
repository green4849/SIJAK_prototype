# 복사해서 .env 로 사용: cp .env.example .env
# 값은 backend/app/core/config.py 의 Settings 필드와 1:1 대응 (대소문자 무관)

ENV=local
DATABASE_URL=postgresql+asyncpg://wipi:wipi@localhost:5432/wipi
CORS_ORIGINS=["http://localhost:5173"]

# Stage 1 — 인증
JWT_SECRET=change-me-local-only-32bytes-minimum!!
COOKIE_SECURE=false
# base64 32바이트: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PHONE_HASH_PEPPER=change-me-pepper
IDENTITY_PROVIDER=mock
# 서비스 대상은 60+. 팀원 본인 정보로 시연하려면 0으로
MIN_SIGNUP_AGE=60

# Stage 2~3 — LLM / STT / TTS (해당 스테이지에서 추가)
# Stage 6 — 공공데이터포털 키 (해당 스테이지에서 추가)
