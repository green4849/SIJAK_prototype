# 복사해서 .env 로 사용: cp .env.example .env
# 값은 backend/app/core/config.py 의 Settings 필드와 1:1 대응 (대소문자 무관)

# local | test | prod — prod 에서는 아래 기본값이 하나라도 남아 있으면 서버가 뜨지 않는다 (B1)
#   JWT_SECRET 32자 이상 / DATA_ENCRYPTION_KEY 새 32바이트 / PHONE_HASH_PEPPER 16자 이상
#   CORS_ORIGINS 는 https:// 만 / 로그인 방식별 설정값 필수
#   COOKIE_SECURE 는 prod 에서 자동 true
ENV=local
DATABASE_URL=postgresql+asyncpg://wipi:wipi@localhost:5432/wipi
CORS_ORIGINS=["http://localhost:5173"]

# Stage 1 — 인증
JWT_SECRET=change-me-local-only-32bytes-minimum!!
COOKIE_SECURE=false
# base64 32바이트: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PHONE_HASH_PEPPER=change-me-pepper
IDENTITY_PROVIDER=mock
# firebase 로 바꾸면 아래 세 값이 필요 (Firebase 콘솔 → 프로젝트 설정 → 웹 앱). 순서: docs/deploy-render.md
# FIREBASE_PROJECT_ID=
# FIREBASE_WEB_API_KEY=
# FIREBASE_APP_ID=
# 긴급 도움 → 보호자 문자 (C10): off(기록만, 기본) | log(로컬 개발 — 보내지 않고 로그만, 운영 금지) | solapi
SMS_PROVIDER=off
# solapi 일 때: 솔라피 콘솔의 API 키·시크릿, 솔라피에 등록한 발신번호(숫자만)
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SMS_SENDER_NUMBER=
# 실제 본인인증(B4) 계약 전 시범 운영에서만 true — 누구나 화면에 뜬 번호로 가입할 수 있게 된다
ALLOW_MOCK_IDENTITY_IN_PROD=false
# phone: 현재 전화 로그인 / kakao: 카카오 계정 로그인 (본인확인은 아님)
AUTH_MODE=phone
# 카카오 디벨로퍼스에 등록한 REST API 키·클라이언트 시크릿·정확한 Redirect URI
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=https://example.com/login/kakao/callback
# 서비스 대상은 60+. 팀원 본인 정보로 시연하려면 0으로
MIN_SIGNUP_AGE=60

# Stage 2~3 — LLM / STT / TTS (해당 스테이지에서 추가)
# C7 — 공공데이터포털 '노인복지시설' 인증키. 각자 발급받아 .env 에만 (저장소에 넣지 않기).
#      비워 두면 scripts.import_welfare 가 실행되지 않고, 화면은 시드의 예시 시설만 보여 준다
# PUBLIC_DATA_API_KEY=

# 운영 음성 저장소. 기본 local, s3 선택 시 비공개 전용 버킷을 준비한다.
# MEDIA_STORAGE=s3
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=ap-southeast-1
# MEDIA_S3_ENDPOINT=https://...
# MEDIA_S3_PREFIX=voice/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 오류 수집. 비우면 전송 없음. 실값은 호스팅 환경에만 입력.
# SENTRY_DSN=
# RELEASE=커밋SHA
# 프런트 빌드 환경 VITE_SENTRY_DSN / VITE_RELEASE 는 별도 설정.

# 암호화 DB 백업. 전화번호 암호화 키와 별도로 생성·보관한다.
# BACKUP_ENCRYPTION_KEY=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=https://...
# BACKUP_S3_REGION=ap-southeast-1
# RESTORE_DATABASE_URL=복구용빈DB주소
# 이전 키로 복호화하며 새 키로 재암호화할 때만. 실제 키는 환경값에만 입력.
# DATA_ENCRYPTION_PREVIOUS_KEYS=["이전키"]
